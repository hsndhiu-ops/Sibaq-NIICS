# Supabase Configuration:
# Required for connecting to Supabase database, authentication, and storage.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
# Service Role Key for serverless user provisioning (/api/create-user)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Web Push Notification VAPID Configuration:
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VITE_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_SUBJECT="https://sibaq-niics.vercel.app/"
